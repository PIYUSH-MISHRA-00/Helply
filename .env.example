# Core provider selection
TRANSCRIPTION_PROVIDER=groq
CHAT_PROVIDER=groq

# Groq
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3
GROQ_CHAT_MODEL=llama-3.3-70b-versatile

# OpenAI
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TRANSCRIPTION_MODEL=whisper-1
OPENAI_CHAT_MODEL=gpt-4o-mini

# Anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_CHAT_MODEL=claude-3-5-sonnet-latest

# Ollama local server
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.1

# LM Studio local server
LMSTUDIO_BASE_URL=http://localhost:1234
LMSTUDIO_CHAT_MODEL=local-model

# Any OpenAI-compatible endpoint (cloud/local)
CUSTOM_API_KEY=
CUSTOM_BASE_URL=https://your-api-endpoint.com/v1
CUSTOM_TRANSCRIPTION_MODEL=whisper-1
CUSTOM_CHAT_MODEL=gpt-4o-mini
