{
  "manifest_version": 3,
  "name": "Helply – Interview Copilot",
  "version": "2.2.2",
  "description": "Interview copilot in a small window under your camera. It listens to the meeting tab and your microphone on its own, and gets out of the way of a screen share.",
  "permissions": ["storage", "tabCapture"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Helply",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["guard-main.js"],
      "run_at": "document_start",
      "all_frames": true,
      "world": "MAIN"
    },
    {
      "matches": ["<all_urls>"],
      "js": ["guard.js"],
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "helply@helply.app",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["personalCommunications"]
      }
    }
  }
}
