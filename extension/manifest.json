{
  "manifest_version": 3,
  "name": "Helply – Interview Copilot",
  "version": "2.1.0",
  "description": "Interview copilot docked in the browser. It listens to the meeting tab and your microphone on its own, and stays out of a tab share.",
  "permissions": ["storage", "tabCapture", "sidePanel"],
  "host_permissions": ["<all_urls>"],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Helply",
    "default_icon": "icon.png"
  },
  "icons": {
    "128": "icon.png"
  },
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "helply@helply.app",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["personalCommunications"]
      }
    }
  }
}
